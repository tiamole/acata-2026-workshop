{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "acata-workshop-api",
  "account_id": "408edd29734d1610c8046af8c3f4fc02",
  "main": "worker.js",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    "ALLOWED_ORIGIN": "https://tiamole.github.io",
    "RESEARCH_ENABLED": "false",
    "RESEARCH_RETENTION_DAYS": "0",
    "RESEARCH_CONTACT": "",
    "RESEARCH_APPROVAL": "",
    "RESEARCH_CONSENT_VERSION": "",
    "RESEARCH_CONSENT_TEXT": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "acata-workshop",
      "database_id": "83eb95cc-990a-47f1-8349-f6851756a5fc",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["17 4 * * *"] }
}
